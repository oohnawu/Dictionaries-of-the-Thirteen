{
  "eval_root": "../eval_data/json",
  "output_root": "./baseline_results",
  "resources": {
    "部首识别": {
      "path": "../data/restricted/merged_部首.xlsx",
      "key_field": "字词",
      "value_field": "部首"
    },
    "拼音注音": {
      "path": "../data/restricted/merge_拼音&反切.xlsx",
      "key_field": "字词",
      "value_field": "拼音"
    },
    "反切注音": {
      "path": "../data/restricted/merge_拼音&反切.xlsx",
      "key_field": "字词",
      "value_field": "反切音"
    },
    "词性识别": {
      "path": "../data/restricted/merged_词性&例句&释义.xlsx",
      "key_field": "字词",
      "value_field": "词性",
      "example_field": "例句_校准"
    },
    "释义能力": {
      "path": "../data/restricted/merged_词性&例句&释义.xlsx",
      "key_field": "字词",
      "definition_field": "释义",
      "pos_field": "词性",
      "example_field": "例句_校准",
      "paragraph_field": "包含例句的段落",
      "book_field": "书名",
      "chapter_field": "章节"
    },
    "语境理解": {
      "path": "../data/restricted/merged_词性&例句&释义.xlsx",
      "key_field": "字词",
      "answer_field": "释义",
      "example_field": "例句_校准",
      "pos_field": "词性"
    }
  },
  "bm25": {
    "top_k": 3,
    "k1": 1.5,
    "b": 0.75,
    "empty_prediction": "未检索到相关释义"
  },
  "leakage_filter": {
    "similarity_threshold": 0.9,
    "containment_min_chars": 6,
    "ngram_size": 3,
    "diversity_ngram_size": 2
  },
  "definition_rag": {
    "index_path": "./derived_data/definition_rag_kb_b.json",
    "test_context_path": "../eval_data/json/语境理解/0-shot/语境理解_eval.json",
    "source_dictionary": "十三经辞典",
    "reference_dictionary": "汉语大词典",
    "max_unique_senses": 20,
    "max_definition_chars": 300,
    "max_example_chars": 260,
    "max_paragraph_chars": 420
  },
  "rag": {
    "backend": "bailian",
    "model_path": "/path/to/Qwen3-8B",
    "output_model_name": "qwen3-8b-bailian-rag-formal",
    "bailian": {
      "model": "qwen3-8b",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "timeout_seconds": 600,
      "max_attempts": 5,
      "retry_wait_seconds": 10,
      "request_interval_seconds": 1,
      "stream": true,
      "enable_thinking": false,
      "temperature": 0
    },
    "top_k_by_task": {
      "释义能力": 20,
      "语境理解": 5
    },
    "max_reference_chars_by_task": {
      "释义能力": 600,
      "语境理解": 1200
    },
    "max_input_tokens": 8192,
    "max_new_tokens": 512,
    "load_in_4bit": false
  }
}
